{
  "name": "@english-test-free/exercise-system",
  "version": "1.4.0",
  "description": "Exercise system components for English Test Free platform",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "clean": "rm -rf dist",
    "verify:build": "yarn build && ! find dist -type f \\( -name '*stories*' -o -name '*mocks*' \\) | grep -q . && echo '✅ Build verified - no stories/mocks in dist' || (echo '❌ ERROR: Stories/mocks found in dist!' && exit 1)",
    "prepublishOnly": "yarn clean && yarn build",
    "publish:npm": "npm publish --access public",
    "publish:npm-private": "npm publish --access restricted",
    "publish:github": "npm publish",
    "publish:interactive": "./publish.sh",
    "version:patch": "npm version patch",
    "version:minor": "npm version minor",
    "version:major": "npm version major",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build"
  },
  "keywords": [
    "exercise",
    "quiz",
    "spelling",
    "education",
    "react",
    "nextjs"
  ],
  "author": "English Test Free Team",
  "license": "MIT",
  "private": false,
  "publishConfig": {
    "access": "restricted",
    "registry": "https://npm.pkg.github.com"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/english-test-free/english-test-free.git",
    "directory": "packages/exercise-system"
  },
  "peerDependencies": {
    "next": ">=14.0.0",
    "react": ">=18.0.0",
    "react-dom": ">=18.0.0"
  },
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@mui/material": "7.3.6",
    "cheerio": "^1.0.0-rc.12",
    "crypto-js": "^4.2.0",
    "lodash": "^4.17.21",
    "next": "15.5.9"
  },
  "devDependencies": {
    "@chromatic-com/storybook": "^4.1.3",
    "@storybook/addon-a11y": "^10.1.11",
    "@storybook/addon-docs": "^10.1.11",
    "@storybook/addon-onboarding": "^10.1.11",
    "@storybook/addon-vitest": "^10.1.11",
    "@storybook/nextjs-vite": "^10.1.11",
    "@tailwindcss/postcss": "^4.1.18",
    "@types/cheerio": "^0.22.0",
    "@types/crypto-js": "^4.2.0",
    "@types/lodash": "^4.14.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitest/browser-playwright": "^4.0.17",
    "@vitest/coverage-v8": "^4.0.17",
    "autoprefixer": "^10.4.23",
    "playwright": "^1.57.0",
    "postcss": "^8.5.6",
    "storybook": "^10.1.11",
    "tailwindcss": "^4.1.18",
    "typescript": "^5.0.0",
    "vite": "^7.3.1",
    "vitest": "^4.0.17"
  }
}
